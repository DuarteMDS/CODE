<Window x:Class="CableTrayVoidCutter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cable Tray Void Cutter"
        Width="900" Height="640"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,6,0,4"/>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor"  Value="Hand"/>
        </Style>

        <!-- Small icon button (in DataGrid rows) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="ToolTip"         Value="Zoom to this clash in Revit and select elements"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="Auto"/>  <!-- 1: mep filter -->
            <RowDefinition Height="Auto"/>  <!-- 2: margin row -->
            <RowDefinition Height="*"    />  <!-- 3: clash list -->
            <RowDefinition Height="Auto"/>  <!-- 4: family selection -->
            <RowDefinition Height="Auto"/>  <!-- 5: status bar -->
            <RowDefinition Height="Auto"/>  <!-- 6: action buttons -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Toolbar ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="⟳  Detect Clashes"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding DetectClashesCommand}"
                    IsEnabled="{Binding IsBusy,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        Converter={StaticResource BoolToVis}}"/>
            <Button Content="Select All"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SelectAllCommand}"
                    Margin="8,0,0,0"/>
            <Button Content="Deselect All"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding DeselectAllCommand}"
                    Margin="4,0,0,0"/>
            <Separator Width="1" Margin="10,2"/>
            <Button Content="⚙ Settings"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenSettingsCommand}"/>
        </StackPanel>

        <!-- ── Row 1: MEP element filter ───────────────────────────────────── -->
        <Border Grid.Row="1" Background="#F0F4FF" BorderBrush="#B8C8E8"
                BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <!-- MEP categories -->
                <TextBlock Text="Éléments MEP :" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                <CheckBox Content="Chemins de câbles"
                          IsChecked="{Binding ScanCableTrays}"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="Inclure les chemins de câbles droits"/>
                <CheckBox Content="Raccords CT"
                          IsChecked="{Binding ScanCableTrayFittings}"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="Inclure les raccords de chemins de câbles (coudes, tés…)"/>
                <CheckBox Content="Conduits"
                          IsChecked="{Binding ScanConduits}"
                          VerticalAlignment="Center"
                          ToolTip="Inclure les conduits circulaires"/>

                <!-- Separator -->
                <Separator Width="1" Margin="14,2"/>

                <!-- Wall orientation filter -->
                <TextBlock Text="Murs :" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="8,0,8,0"/>
                <ComboBox SelectedItem="{Binding WallOrientationLabel}"
                          Width="180" VerticalAlignment="Center"
                          ToolTip="Choisir l'orientation des murs à analyser">
                    <ComboBoxItem>Verticaux uniquement</ComboBoxItem>
                    <ComboBoxItem>Horizontal uniquement</ComboBoxItem>
                    <ComboBoxItem>Verticaux et horizontaux</ComboBoxItem>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- ── Row 2: Margin ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Clearance margin:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding MarginMm, UpdateSourceTrigger=PropertyChanged}"
                     Width="60" Margin="8,0,4,0" VerticalAlignment="Center"
                     ToolTip="Extra clearance added around each cable tray / conduit (mm)"/>
            <TextBlock Text="mm" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Row 3: Clash list ────────────────────────────────────────────── -->
        <GroupBox Grid.Row="3" Header="Detected Clashes" Margin="0,0,0,6">
            <Grid>
                <!-- Loading overlay -->
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <DataGrid ItemsSource="{Binding ClashResults}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          FontSize="12">

                    <DataGrid.Columns>

                        <!-- Checkbox -->
                        <DataGridTemplateColumn Width="32" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- MEP element name -->
                        <DataGridTextColumn Header="MEP Element"
                                            Binding="{Binding CableTrayName}"
                                            Width="180"
                                            IsReadOnly="True"/>

                        <!-- MEP category (Cable Tray / CT Fitting / Conduit) -->
                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding MepCategoryDisplay}"
                                            Width="80"
                                            IsReadOnly="True"/>

                        <!-- Shape + dimensions (Rect or Circular) -->
                        <DataGridTextColumn Header="Shape"
                                            Binding="{Binding TrayShapeDisplay}"
                                            Width="120"
                                            IsReadOnly="True"/>

                        <!-- Clash Type (Wall / Beam) -->
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding ClashTypeDisplay}"
                                            Width="55"
                                            IsReadOnly="True"/>

                        <!-- Clashing element -->
                        <DataGridTextColumn Header="Clashing Element"
                                            Binding="{Binding ClashingElementName}"
                                            Width="*"
                                            IsReadOnly="True"/>

                        <!-- Source (Host / Linked) -->
                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding Source}"
                                            Width="60"
                                            IsReadOnly="True"/>

                        <!-- Link name -->
                        <DataGridTextColumn Header="Link"
                                            Binding="{Binding LinkName}"
                                            Width="120"
                                            IsReadOnly="True"/>

                        <!-- "Show in Revit" button -->
                        <DataGridTemplateColumn Width="38" Header="🔍">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🎯"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding DataContext.ShowInRevitCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Zoom to clash and select elements in Revit"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state message -->
                <TextBlock Text="No clashes detected yet. Click &quot;Detect Clashes&quot; above."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding ClashResults.Count,
                               Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </GroupBox>

        <!-- ── Row 4: Family selection ─────────────────────────────────────── -->
        <GroupBox Grid.Row="4" Header="Void Families (optionnel pour les murs)" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Wall family -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Wall void family:" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding WallFamilies}"
                              SelectedItem="{Binding SelectedWallFamily}"
                              DisplayMemberPath="Name"
                              ToolTip="Family used to cut host-model walls (not required – openings are created automatically)"/>
                </StackPanel>

                <!-- Beam family -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Beam void family:" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding BeamFamilies}"
                              SelectedItem="{Binding SelectedBeamFamily}"
                              DisplayMemberPath="Name"
                              ToolTip="Family used to cut structural beams (required for beam voids)"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ── Row 5: Status bar ────────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="#F3F3F3" BorderBrush="#DDD"
                BorderThickness="1" Padding="6,3" Margin="0,0,0,6" CornerRadius="2">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"/>
        </Border>

        <!-- ── Row 6: Action buttons ────────────────────────────────────────── -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Apply Selected Voids"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="Close"
                    Style="{StaticResource SecondaryButton}"
                    Click="CloseButton_Click"
                    Padding="14,5"/>
        </StackPanel>
    </Grid>
</Window>
