<Window x:Class="CableTrayVoidCutter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cable Tray Void Cutter"
        Width="1020" Height="760"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,4,0,3"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor"  Value="Hand"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="FontSize"        Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Background"      Value="#C75000"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: toolbar -->
            <RowDefinition Height="Auto"/>   <!-- 1: MEP filter -->
            <RowDefinition Height="Auto"/>   <!-- 2: margin + hint -->
            <RowDefinition Height="2.2*"/>   <!-- 3: clash list (main) -->
            <RowDefinition Height="*"    />  <!-- 4: alignment panel -->
            <RowDefinition Height="Auto"/>   <!-- 5: status bar -->
            <RowDefinition Height="Auto"/>   <!-- 6: action buttons -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Toolbar ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="⟳  Détecter conflits"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding DetectClashesCommand}"/>
            <Button Content="Tout sélectionner"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SelectAllCommand}"
                    Margin="8,0,0,0"/>
            <Button Content="Tout désélectionner"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding DeselectAllCommand}"
                    Margin="4,0,0,0"/>
            <Separator Width="1" Margin="10,2"/>
            <Button Content="⚙ Paramètres"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenSettingsCommand}"/>
            <Separator Width="1" Margin="10,2"/>
            <Button Content="⚠ Vérifier alignements"
                    Style="{StaticResource WarningButton}"
                    Command="{Binding CheckAlignmentCommand}"
                    ToolTip="Compare les positions MEP actuelles avec celles mémorisées à l'insertion"/>
        </StackPanel>

        <!-- ── Row 1: MEP filter ────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#F0F4FF" BorderBrush="#B8C8E8"
                BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="Éléments MEP :" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                <CheckBox Content="Chemins de câbles"
                          IsChecked="{Binding ScanCableTrays}"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="Détection auto. chemin de câbles / échelle à câbles"/>
                <CheckBox Content="Raccords CT"
                          IsChecked="{Binding ScanCableTrayFittings}"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox Content="Conduits"
                          IsChecked="{Binding ScanConduits}"
                          VerticalAlignment="Center"/>
                <Separator Width="1" Margin="14,2"/>
                <TextBlock Text="Murs :" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="8,0,8,0"/>
                <ComboBox SelectedItem="{Binding WallOrientationLabel}" Width="180" VerticalAlignment="Center">
                    <ComboBoxItem>Verticaux uniquement</ComboBoxItem>
                    <ComboBoxItem>Horizontal uniquement</ComboBoxItem>
                    <ComboBoxItem>Verticaux et horizontaux</ComboBoxItem>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- ── Row 2: Margin + hint ──────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Marge :" VerticalAlignment="Center"/>
            <TextBox Text="{Binding MarginMm, UpdateSourceTrigger=PropertyChanged}"
                     Width="55" Margin="6,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="mm" VerticalAlignment="Center"/>
            <TextBlock Text="   ℹ Ctrl+clic = toggle · Shift+clic = plage · Changement de famille → propagé à toutes les lignes sélectionnées"
                       VerticalAlignment="Center" Foreground="#666" FontSize="10" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- ── Row 3: Clash list ────────────────────────────────────────────── -->
        <GroupBox Grid.Row="3" Margin="0,0,0,6"
                  Header="{Binding ClashResults.Count,
                           StringFormat='Conflits détectés ({0}) — traversées complètes uniquement'}">
            <Grid>
                <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <DataGrid x:Name="ClashGrid"
                          ItemsSource="{Binding ClashResults}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          FontSize="11"
                          PreviewMouseLeftButtonDown="ClashGrid_PreviewMouseLeftButtonDown">

                    <DataGrid.Columns>

                        <!-- ── Checkbox ── -->
                        <DataGridTemplateColumn Width="30" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ── MEP element ── -->
                        <DataGridTextColumn Header="Élément MEP"
                                            Binding="{Binding CableTrayName}"
                                            Width="150" IsReadOnly="True"/>

                        <!-- ── Category (shows Cable Tray / Ladder Tray / Conduit …) ── -->
                        <DataGridTextColumn Header="Catégorie"
                                            Binding="{Binding MepCategoryDisplay}"
                                            Width="95" IsReadOnly="True"/>

                        <!-- ── Shape ── -->
                        <DataGridTextColumn Header="Section"
                                            Binding="{Binding TrayShapeDisplay}"
                                            Width="115" IsReadOnly="True"/>

                        <!-- ── Clash type ── -->
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding ClashTypeDisplay}"
                                            Width="55" IsReadOnly="True"/>

                        <!-- ── Clashing element ── -->
                        <DataGridTextColumn Header="Élément en conflit"
                                            Binding="{Binding ClashingElementName}"
                                            Width="*" IsReadOnly="True"/>

                        <!-- ── Source ── -->
                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding Source}"
                                            Width="55" IsReadOnly="True"/>

                        <!-- ── Link ── -->
                        <DataGridTextColumn Header="Lien"
                                            Binding="{Binding LinkName}"
                                            Width="100" IsReadOnly="True"/>

                        <!--
                            ── Famille de réservation (par ligne) ──────────────────
                            Auto-assigned from settings; editable per row.
                            Changing on a selected row propagates to all other selected rows.
                        -->
                        <DataGridTemplateColumn Header="Famille réservation" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        ItemsSource="{Binding DataContext.AllFamilies,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedItem="{Binding AssignedFamily, Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                        DisplayMemberPath="Name"
                                        ToolTip="Famille auto-sélectionnée selon le type MEP. Modifier ici pour changer la famille de toutes les lignes sélectionnées."
                                        FontSize="10"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ── Zoom ── -->
                        <DataGridTemplateColumn Width="34" Header="🔍">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🎯"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding DataContext.ShowInRevitCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Zoomer sur ce conflit (section box en vue 3D)"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Aucun conflit. Cliquez sur « Détecter conflits »."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding ClashResults.Count,
                               Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </GroupBox>

        <!-- ── Row 4: Alignment panel ───────────────────────────────────────── -->
        <GroupBox Grid.Row="4"
                  Header="{Binding MisalignedVoids.Count,
                           StringFormat='Réservations à réaligner ({0})'}"
                  Margin="0,0,0,6">
            <Grid>
                <DataGrid ItemsSource="{Binding MisalignedVoids}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Réservation" Binding="{Binding VoidName}"
                                            Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Élément MEP" Binding="{Binding MepName}"
                                            Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Écart" Binding="{Binding DeltaDisplay}"
                                            Width="70" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="34" Header="🔍">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🎯"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding DataContext.ZoomToMisalignedCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Zoomer sur cet élément"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Aucun désalignement. Cliquez sur « Vérifier alignements »."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding MisalignedVoids.Count,
                               Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </GroupBox>

        <!-- ── Row 5: Status ────────────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="#F3F3F3" BorderBrush="#DDD"
                BorderThickness="1" Padding="6,3" Margin="0,0,0,6" CornerRadius="2">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"/>
        </Border>

        <!-- ── Row 6: Actions ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Insérer les réservations sélectionnées"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="Fermer"
                    Style="{StaticResource SecondaryButton}"
                    Click="CloseButton_Click"
                    Padding="14,5"/>
        </StackPanel>
    </Grid>
</Window>
