<Window x:Class="CableTrayVoidCutter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings – Cable Tray Void Cutter"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Margin ──────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Default clearance margin:" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="MarginBox"
                     Width="60" Margin="8,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="mm" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Family list ─────────────────────────────────────────────────── -->
        <GroupBox Grid.Row="1" Header="Void Families (remembered for next session)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="FamilyGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"       Binding="{Binding Name}"       Width="160"/>
                        <DataGridTextColumn Header="Target"     Binding="{Binding TargetType}"  Width="70"/>
                        <DataGridTextColumn Header="File Path"  Binding="{Binding FilePath}"    Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add / Remove toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Margin="0,6,0,0">
                    <Button Content="+ Add family (.rfa)…"
                            Click="AddFamily_Click"
                            Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="✕ Remove selected"
                            Click="RemoveFamily_Click"
                            Padding="10,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ── Info note ───────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   FontSize="11"
                   Margin="0,6,0,6">
            ℹ Void families must contain parameters named <Bold>Width</Bold>,
            <Bold>Height</Bold>, and <Bold>Depth</Bold> (in feet).
            The <Bold>Target</Bold> column controls in which combo box the family appears
            (Wall, Beam or Both).
        </TextBlock>

        <!-- ── OK / Cancel ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"     Click="OK_Click"     Width="80" Margin="0,0,8,0"
                    IsDefault="True"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="80"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
