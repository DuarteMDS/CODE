<Window x:Class="CableTrayVoidCutter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings – Cable Tray Void Cutter"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Margin ──────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Default clearance margin:" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="MarginBox"
                     Width="60" Margin="8,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="mm" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Family list ─────────────────────────────────────────────────── -->
        <GroupBox Grid.Row="1" Header="Void Families (remembered for next session)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="FamilyGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"       Binding="{Binding Name}"       Width="160"/>
                        <DataGridTextColumn Header="Target"     Binding="{Binding TargetType}"  Width="70"/>
                        <DataGridTextColumn Header="File Path"  Binding="{Binding FilePath}"    Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add / Remove toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Margin="0,6,0,0">
                    <Button Content="+ Add family (.rfa)…"
                            Click="AddFamily_Click"
                            Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="✕ Remove selected"
                            Click="RemoveFamily_Click"
                            Padding="10,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ── Info note ───────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   FontSize="11"
                   Margin="0,6,0,6">
            ℹ Familles CEG supportées : <Bold>CEG_Resa Wall Circle</Bold> (→ Conduit) et
            <Bold>CEG_Resa Wall Rectangular</Bold> (→ CableTray + LadderTray).
            Le type cible est auto-détecté depuis le nom du fichier.
            Paramètres reconnus (par ordre de priorité) :
            largeur → <Bold>GA_Reservation Largeur</Bold> / <Bold>Largeur</Bold> / <Bold>Width</Bold> ;
            hauteur → <Bold>GA_Reservation Longueur</Bold> / <Bold>Longueur</Bold> / <Bold>Height</Bold> ;
            épaisseur → <Bold>GA_Reservation Profondeur</Bold> / <Bold>Profondeur</Bold> / <Bold>Epaisseur</Bold> / <Bold>Depth</Bold> ;
            diamètre → <Bold>Diametre</Bold> / <Bold>Diamètre</Bold> / <Bold>Diameter</Bold>.
            Colonne <Bold>Target</Bold> :
            <Bold>CableTray</Bold> = chemins de câbles (rectangulaires + échelles en fallback) ·
            <Bold>LadderTray</Bold> = échelles à câbles dédiées ·
            <Bold>Conduit</Bold> = conduits circulaires ·
            <Bold>Beam</Bold> = poutres structurelles ·
            <Bold>Both</Bold> = toutes les catégories.
        </TextBlock>

        <!-- ── OK / Cancel ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"     Click="OK_Click"     Width="80" Margin="0,0,8,0"
                    IsDefault="True"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="80"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
