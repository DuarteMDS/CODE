<Window x:Class="CableTrayVoidCutter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres – Cable Tray Void Cutter"
        Width="540" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Margin ──────────────────────────────────────────────────────── -->
        <GroupBox Grid.Row="0" Header="Marge de dégagement">
            <StackPanel Orientation="Horizontal" Margin="4,6,4,4">
                <TextBlock Text="Marge :" VerticalAlignment="Center" Width="60"/>
                <TextBox x:Name="MarginBox" Width="70" VerticalAlignment="Center"/>
                <TextBlock Text=" mm" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- ── Families ────────────────────────────────────────────────────── -->
        <GroupBox Grid.Row="2" Header="Familles de réservation (CEG)">
            <Grid Margin="4,6,4,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <!-- Circle -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Famille circulaire :"
                           VerticalAlignment="Center"
                           ToolTip="CEG_Resa Wall Circle — pour conduits et éléments ronds"/>
                <TextBox   Grid.Row="0" Grid.Column="1"
                           x:Name="CirclePathBox"
                           IsReadOnly="True"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           ToolTip="CEG_Resa Wall Circle"/>
                <Button    Grid.Row="0" Grid.Column="2"
                           Content="Parcourir…"
                           Click="BrowseCircle_Click"
                           VerticalAlignment="Center"/>

                <!-- Rectangular -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Famille rectangulaire :"
                           VerticalAlignment="Center"
                           ToolTip="CEG_Resa Wall Rectangular — pour chemins de câbles et échelles"/>
                <TextBox   Grid.Row="2" Grid.Column="1"
                           x:Name="RectPathBox"
                           IsReadOnly="True"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           ToolTip="CEG_Resa Wall Rectangular"/>
                <Button    Grid.Row="2" Grid.Column="2"
                           Content="Parcourir…"
                           Click="BrowseRect_Click"
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- ── Info ────────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="4"
                   TextWrapping="Wrap"
                   Foreground="#666"
                   FontSize="11"
                   Margin="0,0,0,0">
            Paramètres lus dans les familles :
            <Bold>GA_Width</Bold> (largeur) ·
            <Bold>GA_Height</Bold> (hauteur) ·
            <Bold>GA_Depth</Bold> (épaisseur traversée) — valeurs en pieds.
        </TextBlock>

        <!-- ── OK / Cancel ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK"     Click="OK_Click"     Width="80" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Annuler" Click="Cancel_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
